import requests
from bs4 import BeautifulSoup
import json

# URL der "Alle Sendungen"-Seite von logo!
URL = "https://www.logo.de/alle-sendungen-132.html"

resp = requests.get(URL)
resp.raise_for_status()
soup = BeautifulSoup(resp.text, "html.parser")

articles = []

# Passe den CSS-Selector nach der echten Struktur an
for item in soup.select("article.teaser"):  # Beispiel: Artikel-Container
    title_tag = item.select_one("h3")
    link_tag = item.select_one("a")
    img_tag = item.select_one("img")
    desc_tag = item.select_one("p")
    
    if title_tag and link_tag and img_tag:
        title = title_tag.get_text(strip=True)
        link = link_tag["href"]
        # Vollständige URL sicherstellen
        if link.startswith("/"):
            link = "https://www.logo.de" + link
        img = img_tag.get("data-src") or img_tag.get("src")
        desc = desc_tag.get_text(strip=True) if desc_tag else ""
        articles.append({"title": title, "link": link, "img": img, "desc": desc})

# JSON-Datei speichern
with open("logo_news.json", "w", encoding="utf-8") as f:
    json.dump(articles, f, ensure_ascii=False, indent=2)

print(f"{len(articles)} Beiträge gespeichert.")
